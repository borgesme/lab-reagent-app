DATABASE_URL=postgresql://lab:lab@localhost:5432/lab_reagent
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=lab:
REDIS_FAIL_OPEN=1
RATE_LIMIT_ENABLED=1
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=7
LOG_MAX_SIZE=10m
