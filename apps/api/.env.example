DATABASE_URL=postgresql://lab:lab@localhost:5432/lab_reagent
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 上线 P0-3 tokenVersion 后,把这个置 1 容忍部署前签发的 legacy access/refresh token
# (无 ver/jti claim);所有活跃 session 滚完(≤7d)后改回 0 或删除。
JWT_ALLOW_LEGACY_CLAIMS=0

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=7
LOG_MAX_SIZE=10m
